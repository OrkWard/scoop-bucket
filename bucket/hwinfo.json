    "pre_install": [
        "Get-ChildItem -Path $dir -Include '*32*', '*ARM*' -Recurse -File | Remove-Item -Force -ErrorAction SilentlyContinue",
        "ensure $persist_dir | Out-Null",
        "Get-ChildItem -Path $persist_dir -Filter '*64_KEY.txt' -File | Copy-Item -Destination $dir -Force",
        "if (-not (Test-Path -LiteralPath \"$persist_dir\\HWiNFO64.INI\" -PathType Leaf)) {",
        "    Set-Content -Path \"$dir\\HWiNFO64.INI\" -Value @('[Settings]', 'AutoUpdate=0', 'AutoUpdateBetaDisable=1') -Encoding ascii",
        "}"
    ],
    "persist": "HWiNFO64.INI",
    "bin": [
        [
            "HWiNFO64.exe",
            "HWiNFO"
        ]
    ],
    "shortcuts": [
