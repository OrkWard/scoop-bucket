            "HWiNFO64.exe",
            "HWiNFO"
        ]
    ],
    "pre_uninstall": "Get-ChildItem -Path $dir -Filter '*64_KEY.txt' -File | Copy-Item -Destination $persist_dir -Force",
    "checkver": {
        "url": "https://www.hwinfo.com/ver.txt",
        "regex": "([\\d.-]+)"
    },
    "autoupdate": {
