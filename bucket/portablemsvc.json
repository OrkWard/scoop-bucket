{
    "version": "0.3.0.1",
    "description": "Download and manage portable MSVC and Windows SDK toolchains (fork: nushell activation, XDG base dirs)",
    "homepage": "https://github.com/tgbender/portablemsvc",
    "license": "MIT",
    "depends": "uv",
    "url": "https://video3.orkward.dev/scoop-bucket/portablemsvc/0.3.0.1/portablemsvc-0.3.0.1-py3-none-any.whl",
    "hash": "2010a4cee12df3c6c89383743c59438f9c7f8219019e29b055d04cc891355ac4",
    "pre_install": [
        "$env:UV_TOOL_DIR = \"$dir\\uv-tools\"",
        "$env:UV_TOOL_BIN_DIR = \"$dir\\bin\"",
        "uv tool install --managed-python --from \"$dir\\portablemsvc-0.3.0.1-py3-none-any.whl\" portablemsvc",
        "if ($LASTEXITCODE -ne 0) { throw \"uv tool install failed: $LASTEXITCODE\" }"
    ],
    "bin": "bin\\portablemsvc.exe",
    "notes": "Directories follow XDG_CONFIG_HOME / XDG_DATA_HOME / XDG_CACHE_HOME / XDG_STATE_HOME / XDG_RUNTIME_DIR (PORTABLEMSVC_* overrides). nushell: portablemsvc get-activate --shell nu"
}
